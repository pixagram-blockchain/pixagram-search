{
  "name": "pixagram-search",
  "version": "0.1.0",
  "private": true,
  "description": "Image search engine for Pixagram artworks on Cloudflare (Workers, D1, Queues, Vectorize, Workers AI, R2) with a Hugging Face SigLIP embedding endpoint.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply pixagram-search --local",
    "db:migrate": "wrangler d1 migrations apply pixagram-search --remote",
    "tail": "wrangler tail"
  },
  "dependencies": {
    "@jsquash/png": "^3.1.1",
    "@jsquash/webp": "^1.5.0",
    "hono": "^4.13.9",
    "xbrz-js": "^1.9.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260927.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.142.0"
  },
  "engines": {
    "node": ">=20"
  }
}
